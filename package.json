{
  "name": "d2r2",
  "version": "2.2.3",
  "private": true,
  "description": "Drop images to Cloudflare R2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "vp run typecheck && wxt build",
    "build:firefox": "vp run typecheck && wxt build -b firefox",
    "zip": "vp run typecheck && wxt zip",
    "zip:firefox": "vp run typecheck && wxt zip -b firefox",
    "check": "vp check && vp run typecheck",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wxt": "^0.21.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
